  "compatibilityLevel": "JAVA_${java_version}",
  "plugin": "io.github.fourmisain.taxfreelevels.fabric.MixinConfig",
  "mixins": [
    "CheapAnvilRenameMixin",
    "EnchantmentMenuMixin",
    "FlattenAnvilCostMixin",
    "FlattenEnchantmentCostMixin",
    "FlattenEnchantmentCostPreMixin",
